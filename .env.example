# ---------------------------------------------------------------
# Email alert credentials for the trading strategy monitor
# ---------------------------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains your password.
#
# How to get a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Search "App passwords" → create one named "Trading Monitor"
#   4. Copy the 16-character password (no spaces) into SMTP_PASSWORD below
# ---------------------------------------------------------------

SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
ALERT_TO=your_gmail@gmail.com

# Optional overrides (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
